FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY ["Presentation/IdPicture/IdPicture.csproj", "Presentation/IdPicture/"]
COPY ["Core/MyId.Application/MyId.Application.csproj", "Core/MyId.Application/"]
COPY ["Core/MyId.Domain/MyId.Domain.csproj", "Core/MyId.Domain/"]
COPY ["Infrastructure/MyId.Infrastructure/MyId.Infrastructure.csproj", "Infrastructure/MyId.Infrastructure/"]
COPY ["Infrastructure/MyId.Persistence/MyId.Persistence.csproj", "Infrastructure/MyId.Persistence/"]

RUN dotnet restore "Presentation/IdPicture/IdPicture.csproj"

COPY . .
WORKDIR "/src/Presentation/IdPicture"
RUN dotnet build "IdPicture.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "IdPicture.csproj" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=publish /app/publish .
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "IdPicture.dll"]
